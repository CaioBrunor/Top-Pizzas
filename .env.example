# Copie este arquivo para ".env" e ajuste os valores.

# Porta da API (o Vite encaminha /api e /socket.io para cá).
PORT=3333

# Acesso ao painel administrativo. Sem ADMIN_SENHA, o servidor cria uma senha
# aleatória na primeira vez e mostra no terminal.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha

# Chave que assina os tokens de login (mínimo de 32 caracteres). Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem ela, o servidor cria uma e guarda em server/data/.segredo-jwt.
JWT_SECRET=

# Validade das sessões.
JWT_VALIDADE_CLIENTE=7d
JWT_VALIDADE_ADMIN=8h
JWT_VALIDADE_ENTREGADOR=12h

# Sites que podem chamar a API de outro endereço, separados por vírgula.
# Só é preciso mexer aqui se o site for publicado separado da API.
ORIGENS_PERMITIDAS=http://localhost:5173,http://127.0.0.1:5173

# Endereço do MongoDB.
#   Local ou Docker: mongodb://127.0.0.1:27017/top-pizzas
#   Atlas:           mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/top-pizzas
# Se a senha tiver caracteres especiais (@ : / ?), codifique-os (ex.: @ vira %40).
MONGODB_URI=mongodb://127.0.0.1:27017/top-pizzas

# Pasta onde o servidor guarda o segredo do JWT gerado sozinho (veja JWT_SECRET).
# Os pedidos, clientes e produtos ficam no MongoDB, não aqui.
DADOS_DIR=server/data

# "false" para o servidor começar sem os clientes e pedidos de exemplo
# (só vale na primeira vez, com o banco ainda vazio).
DADOS_DE_EXEMPLO=true

# Em produção, atrás de HTTPS:
# NODE_ENV=production
# FORCAR_HTTPS=true
# PROXIES_CONFIAVEIS=1

# Só para o site publicado separado da API: endereço da API usado no build.
# VITE_API_URL=https://api.seudominio.com.br
